<h1>Lista de Produtos</h1>

<table border="1">
  <tr>
    <td><b>Codigo</b></td>
    <td><b>Nome</b></td>
    <td><b>Categoria</b></td>
    <td><b>Preco</b></td>
    <td><b>Peso (kg)</b></td>
    <td><b>Dimensoes (cm)</b></td>
    <td><b>Volume (L)</b></td>
    <td colspan="3"><b>Operacoes</b></td>
  </tr>

  {{#each produtosBD}}
  <tr>
    <td>{{codigo}}</td>
    <td>{{nome}}</td>
    <td>{{categoria}}</td>
    <td>{{preco}}</td>
    <td>{{peso_kg}}</td>
    <td>{{altura_cm}} x {{largura_cm}} x {{profundidade_cm}}</td>
    <td>{{volume}}</td>
    <td><a href="/produtos/{{codigo}}">Consultar</a></td>
    <td><a href="/produtos/editar/{{codigo}}">Editar</a></td>
    <td><a href="/produtos/excluir/{{codigo}}">Excluir</a></td>
  </tr>
  {{/each}}

</table>
