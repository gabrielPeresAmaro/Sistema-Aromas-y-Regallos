<h1>Cadastro de Produto</h1>

<form action="/produtos/cadastrar" method="POST">
  <label for="nome">Nome do produto:</label><br>
  <input type="text" id="nome" name="nome" maxlength="100"><br><br>

  <label for="descricao">Descrição (até 280 caracteres):</label><br>
  <textarea id="descricao" name="descricao" maxlength="280" cols="40" rows="5"></textarea><br><br>

  <label for="quantidade_estoque">Quantidade em estoque:</label><br>
  <input type="number" id="quantidade_estoque" name="quantidade_estoque" min="0"><br><br>

  <label for="preco">Preço individual:</label><br>
  <input type="number" id="preco" name="preco" step="0.01" min="0"><br><br>

  <label for="categoria">Categoria:</label><br>
  <select id="categoria" name="categoria">
    <option value="">Selecione</option>
    <option value="Cesta">Cesta</option>
    <option value="Item comestível">Item comestível</option>
    <option value="Bebida">Bebida</option>
    <option value="Presente temático">Presente temático</option>
    <option value="Cartão de mensagem">Cartão de mensagem</option>
    <option value="Decoração">Decoração</option>
  </select><br><br>

  <label for="altura_cm">Altura (cm):</label><br>
  <input type="number" id="altura_cm" name="altura_cm" step="0.01" min="0.01" required><br><br>

  <label for="largura_cm">Largura (cm):</label><br>
  <input type="number" id="largura_cm" name="largura_cm" step="0.01" min="0.01" required><br><br>

  <label for="profundidade_cm">Profundidade (cm):</label><br>
  <input type="number" id="profundidade_cm" name="profundidade_cm" step="0.01" min="0.01" required><br><br>

  <label for="peso_kg">Peso (kg):</label><br>
  <input type="number" id="peso_kg" name="peso_kg" step="0.001" min="0.001" required><br><br>

  <small>O volume em litros sera calculado automaticamente a partir da volumetria.</small><br><br>

  <label for="foto">Foto do produto:</label><br>
  <input type="text" id="foto" name="foto">(PNG/JPG - 80px x 80px)<br><br>

  <button type="submit">Cadastrar Produto</button>
</form>
