<h1>Consulta de Produto</h1>

<form action="#" method="POST">

  <label for="codigo">Id do produto:</label><br>
  <input type="text" id="codigo" name="codigo" value="{{produtoPlano.codigo}}" readonly size="3"><br><br>

  <label for="nome">Nome do produto:</label><br>
  <input type="text" id="nome" name="nome" value="{{produtoPlano.nome}}" readonly maxlength="100" size="50"><br><br>

  <label for="descricao">Descricao (ate 280 caracteres):</label><br>
  <textarea id="descricao" name="descricao" readonly maxlength="280" cols="40" rows="5">{{produtoPlano.descricao}}</textarea><br><br>

  <label for="quantidade_estoque">Quantidade em estoque:</label><br>
  <input type="number" id="quantidade_estoque" readonly name="quantidade_estoque" value="{{produtoPlano.quantidade_estoque}}" min="0"><br><br>

  <label for="preco">Preco individual:</label><br>
  <input type="number" id="preco" name="preco" readonly value="{{produtoPlano.preco}}" step="0.01" min="0"><br><br>

  <label for="categoria">Categoria:</label><br>
  <select id="categoria" name="categoria" readonly>
    <option {{#if (eq produtoPlano.categoria "Cesta")}}selected{{/if}} value="Cesta">Cesta</option>
    <option {{#if (eq produtoPlano.categoria "Item comestível")}}selected{{/if}} value="Item comestível">Item comestivel</option>
    <option {{#if (eq produtoPlano.categoria "Bebida")}}selected{{/if}} value="Bebida">Bebida</option>
    <option {{#if (eq produtoPlano.categoria "Presente temático")}}selected{{/if}} value="Presente temático">Presente tematico</option>
    <option {{#if (eq produtoPlano.categoria "Cartão de mensagem")}}selected{{/if}} value="Cartão de mensagem">Cartao de mensagem</option>
    <option {{#if (eq produtoPlano.categoria "Decoração")}}selected{{/if}} value="Decoração">Decoracao</option>
  </select><br><br>

  <label for="altura_cm">Altura (cm):</label><br>
  <input type="number" id="altura_cm" name="altura_cm" readonly value="{{produtoPlano.altura_cm}}" step="0.01" min="0"><br><br>

  <label for="largura_cm">Largura (cm):</label><br>
  <input type="number" id="largura_cm" name="largura_cm" readonly value="{{produtoPlano.largura_cm}}" step="0.01" min="0"><br><br>

  <label for="profundidade_cm">Profundidade (cm):</label><br>
  <input type="number" id="profundidade_cm" name="profundidade_cm" readonly value="{{produtoPlano.profundidade_cm}}" step="0.01" min="0"><br><br>

  <label for="peso_kg">Peso (kg):</label><br>
  <input type="number" id="peso_kg" name="peso_kg" readonly value="{{produtoPlano.peso_kg}}" step="0.001" min="0"><br><br>

  <label for="volume">Volume calculado (L):</label><br>
  <input type="number" id="volume" name="volume" readonly value="{{produtoPlano.volume}}" step="0.01" min="0"><br><br>

  <label for="foto">Foto do produto:</label><br>
  <input type="text" id="foto" name="foto" readonly value="{{produtoPlano.foto}}">(PNG/JPG - 80px x 80px)<br><br>

  <button type="button" onclick="window.location.href='/produtos/excluir/{{produtoPlano.codigo}}'">Excluir produto</button>

</form>
